{
    "name": "coconut",
    "displayName": "Coconut (Official)",
    "description": "Coconut language support for Visual Studio Code, including a language server (errors, hover, completions, go to definition).",
    "version": "2.3.0",
    "publisher": "evhub",
    "author": {
        "name": "evhub"
    },
    "license": "SEE LICENSE IN LICENSE*.txt",
    "repository": {
        "type": "git",
        "url": "https://github.com/evhub/sublime-coconut"
    },
    "bugs": {
        "url": "https://github.com/evhub/sublime-coconut/issues"
    },
    "engines": {
        "vscode": "^1.82.0"
    },
    "keywords": [
        "coconut",
        "language",
        "snippet",
        "support",
        "highlighting",
        "highlighter",
        "functional",
        "python"
    ],
    "categories": [
        "Programming Languages",
        "Snippets",
        "Linters"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:coconut"
    ],
    "contributes": {
        "languages": [
            {
                "id": "coconut",
                "aliases": [
                    "Coconut",
                    "coconut"
                ],
                "extensions": [
                    ".coco",
                    ".coc",
                    ".coconut",
                    ".py_template"
                ],
                "firstLine": "^#!\\s*/?.*\\bcoconut[0-9.-]*\\b",
                "configuration": "./language-configuration.json"
            },
            {
                "id": "coconut-injection"
            }
        ],
        "grammars": [
            {
                "language": "coconut",
                "scopeName": "source.coconut",
                "path": "./langs/Coconut.tmLanguage"
            },
            {
                "language": "coconut-injection",
                "scopeName": "markdown.coconut.codeblock",
                "path": "./langs/codeblock.json",
                "injectTo": [
                    "text.html.markdown"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.coconut": "coconut"
                }
            }
        ],
        "snippets": [
            {
                "language": "coconut",
                "path": "./snippets.json"
            }
        ],
        "configuration": {
            "title": "Coconut",
            "properties": {
                "coconut.languageServer.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to start the Coconut language server (requires 'pip install \"coconut[lsp]\"')."
                },
                "coconut.languageServer.command": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "coconut",
                        "--lsp"
                    ],
                    "description": "The command used to start the Coconut language server (e.g. [\"/path/to/python\", \"-m\", \"coconut.lsp\"] to use a specific Python environment)."
                }
            }
        },
        "commands": [
            {
                "command": "coconut.restartLanguageServer",
                "title": "Coconut: Restart Language Server"
            }
        ]
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    }
}
