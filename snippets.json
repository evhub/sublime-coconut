{
	"matchcase": {
		"prefix": "matchcase",
		"body": "\nmatch ${1:value}:\n    case ${2:pattern}:\n        ${3:pass}\n    case _:\n        ${0:pass}\n",
		"description": "match value: case pattern:",
		"scope": "source.coconut"
	},
	"case": {
		"prefix": "case",
		"body": "\ncase ${1:pattern}:\n    ${0:pass}\n",
		"description": "case pattern: (inside match value:)",
		"scope": "source.coconut"
	},
	"casematch": {
		"prefix": "casematch",
		"body": "\ncase ${1:pattern} if ${2:condition}:\n    ${0:pass}\n",
		"description": "case pattern if condition: (inside match value:)",
		"scope": "source.coconut"
	},
	"defa": {
		"prefix": "defa",
		"body": "\ndef ${1:name}(${2:args}) = \n    ${0:expr}\n",
		"description": "def name() =",
		"scope": "source.coconut"
	},
	"defa1": {
		"prefix": "defa1",
		"body": "\ndef ${1:name}(${2:args}) = ${0:expr}\n",
		"description": "def name() = expr",
		"scope": "source.coconut"
	},
	"deflambda": {
		"prefix": "deflambda",
		"body": "\ndef (${1:args}) => ${0:expr}\n",
		"description": "def (args) => expr",
		"scope": "source.coconut"
	},
	"match": {
		"prefix": "match",
		"body": "\nmatch ${1:pattern} in ${2:value}:\n    $0\n",
		"description": "match ? in ?:",
		"scope": "source.coconut"
	},
	"matchelse": {
		"prefix": "matchelse",
		"body": "\nmatch ${1:pattern} in ${2:value}:\n    $3\nelse:\n    $0\n",
		"description": "match/else",
		"scope": "source.coconut"
	},
	"matchif": {
		"prefix": "matchif",
		"body": "\nmatch ${1:pattern} in ${2:value} if ${3:cond}:\n    $0\n",
		"description": "match ? in ? if ?:",
		"scope": "source.coconut"
	},
	"matchifelse": {
		"prefix": "matchifelse",
		"body": "\nmatch ${1:pattern} in ${2:value} if ${3:cond}:\n    $4\nelse: \n    $0\n",
		"description": "match if/else",
		"scope": "source.coconut"
	},
	"pattern": {
		"prefix": "pattern",
		"body": "\naddpattern def ${1:func}(${2:args}):\n    ${0:pass}\n",
		"description": "new pattern",
		"scope": "source.coconut"
	},
	"casedef": {
		"prefix": "casedef",
		"body": "\ncase def ${1:name}:\n    case(${2:pattern}) = ${3:expr}\n    case(${4:pattern}) = ${0:expr}\n",
		"description": "case def name: case(...) = ...",
		"scope": "source.coconut"
	},
	"data": {
		"prefix": "data",
		"body": "\ndata ${1:Name}(${2:fields}):\n    ${0:pass}\n",
		"description": "data Name(fields):",
		"scope": "source.coconut"
	},
	"where": {
		"prefix": "where",
		"body": "\n${1:result} = ${2:expr} where:\n    ${0:pass}\n",
		"description": "expr where:",
		"scope": "source.coconut"
	}
}
