{
    // Settings for the Coconut language server (requires the LSP package).
    // Override them in Preferences > Package Settings > Coconut > LSP Settings.
    "enabled": true,

    // The Python interpreter used to run the server must have Coconut installed
    // (pip install coconut). Replace "${python}" with e.g. "/path/to/venv/bin/python".
    // This runs Coconut's own server (coconut --lsp) when the installed Coconut has it, else the
    // bundled one; add "--server", "bundled" (or "coconut") to the command to choose explicitly.
    "command": ["${python}", "${server_path}"],

    "selector": "source.coconut",

    // Sent to the server; see the README for details.
    "initializationOptions": {
        // Python version to target: "sys" (the interpreter running Coconut), "3", "3.8", "2.7", ...
        "target": "sys",
        // Coconut's --strict style checks
        "strict": false,
        // lint the compiled code with pyflakes (undefined names, unused variables, ...)
        "lint": true,
        // type-check with mypy on open/save (pip install mypy)
        "mypy": false
    }
}
