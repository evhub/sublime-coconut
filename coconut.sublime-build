{
    "shell_cmd": "coconut \"$file\"",
    "file_regex": "^[ ]*File \"(...*?)\", line ([0-9]*)",
    "selector": "source.coconut",

    "variants":
    [
        {
            "name": "Build Project",
            "shell_cmd": "coconut \"${folder}\"",
        },
        {
            "name": "Build file for 3.6",
            "shell_cmd": "coconut \"${file}\" --target 36",
        },
        {
            "name": "Build project for 3.6",
            "shell_cmd": "coconut \"${folder}\" --target 36",
        },
        {
            "name": "Build and typecheck file",
            "shell_cmd": "coconut \"${file}\" --force --mypy",
        },
        {
            "name": "Check style",
            "shell_cmd": "coconut \"${file}\" --nowrite --strict",
        },
        {
            "name": "Build on changes",
            "shell_cmd": "coconut \"${folder}\" --watch",
        },
        {
            "name": "Run file",
            "shell_cmd": "coconut --run --no-write \"${file}\"",
        },
        {
            "name": "Check file for errors",
            "shell_cmd": "python3 \"${packages}/Coconut/server/coconut_language_server.py\" check \"${file}\"",
            "file_regex": "^(.+?):([0-9]+):([0-9]+): (.*)$",
            "windows": {"shell_cmd": "python \"${packages}/Coconut/server/coconut_language_server.py\" check \"${file}\""},
        },
        {
            "name": "Check project for errors",
            "shell_cmd": "python3 \"${packages}/Coconut/server/coconut_language_server.py\" check \"${folder}\"",
            "file_regex": "^(.+?):([0-9]+):([0-9]+): (.*)$",
            "windows": {"shell_cmd": "python \"${packages}/Coconut/server/coconut_language_server.py\" check \"${folder}\""},
        }
    ]
}
